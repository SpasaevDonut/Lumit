---
// A screenshot slot.
//
// Drop a file into src/assets/shots/ with the name this slot asks for and it
// appears. No markdown edit, no import, nothing to switch on — until then the
// page shows a labelled placeholder naming the file it wants.
//
//   <Shot file="timeline-outline.png" caption="The outline columns." />

const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/shots/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

interface Props {
  /** Filename inside src/assets/shots/ */
  file: string;
  /** Sentence under the image. Also the alt text if `alt` is absent. */
  caption: string;
  /** Alt text, when it should differ from the caption. */
  alt?: string;
}

const { file, caption, alt } = Astro.props;
const hit = shots[`../assets/shots/${file}`];
---

{
  hit ? (
    <figure class="shot">
      <img src={hit.default.src} width={hit.default.width} height={hit.default.height} alt={alt ?? caption} loading="lazy" />
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <figure class="shot shot--wanted" aria-hidden="true">
      <div class="shot__box">
        <span class="shot__label">Screenshot wanted</span>
        <code class="shot__file">{file}</code>
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--sl-color-hairline);
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .shot__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.5rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg-inline-code);
  }
  .shot__label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-4);
  }
  .shot__file {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
</style>
