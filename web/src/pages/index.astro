---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";

const features = [
  {
    h: "Playback is the product",
    p: "A GPU-resident pipeline with content-hash caching and adaptive degradation. The UI thread never renders a frame, so the app answers input in every state — including mid-export.",
  },
  {
    h: "Retiming you don't fight",
    p: "Ramp-and-cut retiming with the feel editors go back to Vegas for, solved on exact rational time so a speed ramp lands on the frame you asked for.",
  },
  {
    h: "Everything After Effects has, eventually",
    p: "Its own version of each AE feature, an AE project importer, and OFX plugin hosting so the tools you already own come with you.",
  },
  {
    h: "Open source, GPLv3",
    p: "The whole engine and interface, in the open. No subscription, no per-seat licence, and no plugin tax on the basics.",
  },
];

const roadmap = [
  {
    h: "Working now",
    items: [
      "Compositing and the layer pipeline",
      "Keyframes and the graph editor",
      "Retiming and speed ramps",
      "Sequence layers",
      "Built-in effects, including lens flare",
      "Text layers",
      "Export",
    ],
  },
  {
    h: "In progress",
    items: [
      "Expressions",
      "Optical-flow retiming",
      "OFX plugin hosting",
      "Beat detection",
      "Masks and mattes",
      "The macOS pass",
    ],
  },
  {
    h: "Later",
    items: [
      "After Effects project import",
      "3D camera and layers",
      "Scripting",
      "Collaborative review",
    ],
  },
];
---

<Base
  title="Lumit — motion graphics that play back at speed"
  description="A native motion-graphics and compositing editor. GPU-first, open source, and built to stay responsive at thousands of layers."
>
  {/* ---------- hero ---------- */}
  <div class="relative overflow-hidden py-16 sm:py-24 lg:py-32">
    <div
      class="pointer-events-none absolute left-1/2 top-[-30%] aspect-square w-[min(1100px,130vw)] -translate-x-1/2"
      style="background: radial-gradient(closest-side, rgb(138 112 255 / 0.16), rgb(134 226 255 / 0.07) 45%, transparent 72%)"
      aria-hidden="true"
    >
    </div>
    <div class="wrap relative">
      <Wordmark class="mb-9 w-[min(340px,68vw)]" />
      <a class="pill" href="/download">
        <span class="h-1.5 w-1.5 rounded-full bg-key-cy"></span>
        <b class="font-medium text-fg">v0.1.0</b> — public beta
      </a>
      <h1
        class="mt-6 max-w-[15ch] text-[clamp(38px,6.4vw,72px)] leading-[1.02] tracking-[-0.042em]"
      >
        Motion graphics that play back at speed.
      </h1>
      <p class="mt-6 max-w-[56ch] text-[clamp(16px,2vw,18.5px)] leading-relaxed">
        A native compositing and motion-graphics editor built first for the editors After
        Effects forgot. GPU-first, open source, and built to stay responsive in projects with
        thousands of layers.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn" href="/download" data-dl>Download</a>
        <a class="btn btn-ghost" href="https://github.com/luminalmvm/Lumit">
          <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path
              d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
            ></path>
          </svg>
          Source
        </a>
      </div>
      <p class="mt-4 text-[13.5px] text-fg-3" data-platnote>
        Windows, Linux and macOS · GPLv3 · free forever
      </p>
    </div>
  </div>

  {/* ---------- features ---------- */}
  <section id="features" class="border-t border-line py-16 sm:py-24">
    <div class="wrap">
      <p class="kicker">Why it exists</p>
      <h2 class="mt-4 text-[clamp(26px,3.6vw,40px)] leading-[1.1]">
        The gaming-edit scene runs on a stack that fights back.
      </h2>
      <p class="mt-4 max-w-[620px]">
        Preview lag, RAM exhaustion, render-time blackmail on blur and retiming, and projects
        that grow until the app is barely usable — plus an external tool chain bolted around
        the gaps. Lumit is one application that covers it: After Effects' compositing model,
        Vegas' retiming soul, GPU-first throughout.
      </p>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-[14px] border border-line bg-line sm:grid-cols-2"
      >
        {
          features.map((f) => (
            <div class="bg-ink p-7">
              <h3 class="text-[18px] tracking-[-0.02em]">{f.h}</h3>
              <p class="mt-2.5 text-[15px]">{f.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- roadmap ---------- */}
  <section id="roadmap" class="border-t border-line bg-ink-2 py-16 sm:py-24">
    <div class="wrap">
      <p class="kicker">Roadmap</p>
      <h2 class="mt-4 text-[clamp(26px,3.6vw,40px)] leading-[1.1]">Where it goes next.</h2>
      <p class="mt-4 max-w-[620px]">
        Lumit is in public beta. This is the honest state of things — what works today, what
        is being built, and what is further out.
      </p>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          roadmap.map((col) => (
            <div>
              <p class="kicker">{col.h}</p>
              <ul class="mt-3.5 list-none p-0">
                {col.items.map((i) => (
                  <li class="border-b border-line py-1.5 text-[14.5px] last:border-0">{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- close ---------- */}
  <section class="border-t border-line py-16 text-center sm:py-24">
    <div class="wrap">
      <h2 class="text-[clamp(26px,3.6vw,40px)] leading-[1.1]">Built for the flow.</h2>
      <p class="mx-auto mt-4 max-w-[620px]">
        Free, open source, and yours to keep. Windows and Linux builds are ready now; macOS
        is close behind.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn" href="/download">Download Lumit</a>
        <a class="btn btn-ghost" href="https://docs.lumitlab.com">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Name the visitor's OS on the hero button. Pure enhancement: the button already
  // links to /download, so a failure here changes nothing.
  const ua = navigator.userAgent;
  const os = /Win/.test(ua)
    ? "Windows"
    : /Mac/.test(ua)
      ? "macOS"
      : /Linux|X11/.test(ua)
        ? "Linux"
        : null;
  if (os) {
    const btn = document.querySelector<HTMLAnchorElement>("[data-dl]");
    if (btn) btn.textContent = `Download for ${os}`;
    if (os === "macOS") {
      const note = document.querySelector("[data-platnote]");
      if (note)
        note.textContent = "macOS build is unsigned — see the download page. GPLv3 · free forever";
    }
  }
</script>
