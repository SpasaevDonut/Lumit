    </linearGradient>
    <linearGradient id="wm-b" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8a70ff" /><stop offset="1" stop-color="#ff4f9e" />
    </linearGradient>
    <radialGradient id="wm-core">
      <stop offset="0" stop-color="#fff" /><stop offset="0.5" stop-color="#fff" stop-opacity="0.8" />
      <stop offset="1" stop-color="#eaf4ff" stop-opacity="0" />
    </radialGradient>
