    12%  { d: path("M87.96 -35.00 L116.76 -63.80 L131.26 -49.30 L116.96 -35.00 L131.26 -20.70 L116.76 -6.20 Z"); transform: none; stroke-width: 12 }
    86%, 100% { d: path("M87.96 -35.00 L135.56 -82.60 L142.38 -75.77 L102.30 -35.68 L126.60 -11.38 L119.09 -3.87 Z");
               transform: translate(-87.55px, 13.14px) rotate(-45deg); stroke-width: 3 }
  }
  @keyframes wm-b {
    0%   { d: path("M182.04 -35.00 L153.24 -6.20 L138.74 -20.70 L153.04 -35.00 L138.74 -49.30 L153.24 -63.80 Z"); transform: none; stroke-width: 12 }
    12%  { d: path("M182.04 -35.00 L153.24 -6.20 L138.74 -20.70 L153.04 -35.00 L138.74 -49.30 L153.24 -63.80 Z"); transform: none; stroke-width: 12 }
    86%, 100% { d: path("M182.04 -35.00 L134.44 12.60 L127.62 5.77 L167.70 -34.32 L143.40 -58.62 L150.91 -66.13 Z");
               transform: translate(79.27px, -13.45px) rotate(-45deg); stroke-width: 3 }
  }
  @keyframes wm-core {
    0%   { transform: scale(1); opacity: .85 }
    28%  { transform: scale(1.6); opacity: 1 }
    44%  { transform: scale(1.85); opacity: 1 }
    58%, 100% { transform: scale(1.15); opacity: 0 }
  }

  @media (prefers-reduced-motion: reduce) {
    .g { opacity: 1; animation: none }
    .core { opacity: 0; animation: none }
    .kA { transform: translate(-87.55px, 13.14px) rotate(-45deg); animation: none }
    .kB { transform: translate(79.27px, -13.45px) rotate(-45deg); animation: none }
  }
</style>
