---
// The Lumit wordmark, assembled on load out of the app mark.
//
// The mark reads as two chevrons either side of a white core, so that is what
// these paths are — the icon's own silhouette, six corners each. An L is also six
// corners and they correspond one for one, so the letter is a straight
// interpolation of the keyframe. The t is the L turned 180 degrees, which is free:
// ">" is "<" turned 180.
//
// Beats. The pair throw apart and return on ONE curve — easeOutBack passes through
// zero velocity at its peak, so the return starts the instant they stop and there
// is no seam where two eased halves would meet. At that peak the turn begins, on a
// quart in-out: precise and mechanical rather than springy. The white between them
// is pulled out as they go, its tips tracking their inner edges, then fades to
// leave the letters it was covering.
//
// The turn pivots on the chevron corner that BECOMES the letter corner — top-left
// on the left, bottom-right on the right. That point is fixed for the whole snap
// (asserted at build time), so the shape swings around a real nail.
//
// Driven from script rather than CSS: `d` is animatable in CSS on paper, but iOS
// Safari does not do it. Without script, or under reduced motion, the markup is
// already the finished wordmark standing still.
interface Props { class?: string }
const { class: klass } = Astro.props;
---

<svg class:list={["wm", klass]} viewBox="-14 -92 294 106" role="img" aria-label="Lumit" fill="none">
  <defs>
    <linearGradient id="wm-a" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#86e2ff" /><stop offset="1" stop-color="#2f6fe0" />
    </linearGradient>
    <linearGradient id="wm-b" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8a70ff" /><stop offset="1" stop-color="#ff4f9e" />
    </linearGradient>
    <filter id="wm-soft" x="-70%" y="-70%" width="240%" height="240%">
      <feGaussianBlur stdDeviation="7" />
    </filter>
    <clipPath id="wm-dia"><path class="diaclip" d="M135.0 -50.0 L150.0 -35.0 L135.0 -20.0 L120.0 -35.0 Z" /></clipPath>
  </defs>

  <g class="letters" opacity="0">
    <path class="g" d="M80.76876401901245 1.2390613555908203Q74.91525411605835 1.2390613555908203 70.92970609664917 -1.4359354972839355Q66.94415807723999 -4.110932350158691 64.93165493011475 -8.934366703033447Q62.9191517829895 -13.757801055908203 62.9191517829895 -20.186316967010498V-52.734375H75.01908540725708V-21.476149559020996Q75.01908540725708 -15.081226825714111 77.30932235717773 -11.615592241287231Q79.59955930709839 -8.149957656860352 84.88903045654297 -8.149957656860352Q88.4160041809082 -8.149957656860352 91.26132726669312 -9.978288412094116Q94.10665035247803 -11.80661916732788 95.80860733985901 -15.765619277954102Q97.51056432723999 -19.724619388580322 97.51056432723999 -26.108229160308838V-52.734375H109.61049795150757V0.0H97.99884557723999V-12.385547161102295L98.3574390411377 -10.22031307220459Q96.10509872436523 -5.035161972045898 91.64044857025146 -1.898050308227539Q87.1757984161377 1.2390613555908203 80.76876401901245 1.2390613555908203Z" />
    <path class="g" d="M124.1984486579895 0.0V-52.734375H135.81010103225708V-44.0371036529541Q137.95111179351807 -48.44100475311279 142.11361408233643 -51.20722055435181Q146.27611637115479 -53.97343635559082 151.9155740737915 -53.97343635559082Q157.30814933776855 -53.97343635559082 161.13959550857544 -51.200973987579346Q164.97104167938232 -48.42851161956787 166.8417453765869 -43.220698833465576Q169.6175217628479 -48.44100475311279 174.02279376983643 -51.20722055435181Q178.42806577682495 -53.97343635559082 183.78666639328003 -53.97343635559082Q191.6069746017456 -53.97343635559082 195.93353867530823 -48.38789105415344Q200.26010274887085 -42.802345752716064 200.26010274887085 -32.56485462188721V0.0H188.16016912460327V-32.417190074920654Q188.16016912460327 -35.985565185546875 187.43399381637573 -38.72033953666687Q186.7078185081482 -41.455113887786865 184.9533200263977 -43.01976561546326Q183.19882154464722 -44.58441734313965 180.04060983657837 -44.58441734313965Q176.4398217201233 -44.58441734313965 173.7874686717987 -42.364299297332764Q171.13511562347412 -40.14418125152588 169.70717906951904 -36.10921502113342Q168.27924251556396 -32.07424879074097 168.27924251556396 -26.5968918800354V0.0H156.1793088912964V-32.417190074920654Q156.1793088912964 -35.985565185546875 155.45313358306885 -38.72873783111572Q154.7269582748413 -41.47191047668457 152.98007726669312 -43.02816390991211Q151.23319625854492 -44.58441734313965 148.12381267547607 -44.58441734313965Q144.523024559021 -44.58441734313965 141.85465574264526 -42.388713359832764Q139.18628692626953 -40.19300937652588 137.7423346042633 -36.14964485168457Q136.29838228225708 -32.10628032684326 136.29838228225708 -26.580095291137695V0.0Z" />
    <path class="g" d="M213.9933705329895 0.0V-52.734375H226.09330415725708V0.0Z" />
  </g>

  <path class="key" data-key="a" d="M72.20 -9.20 L119.80 -56.80 L126.63 -49.97 L86.54 -9.89 L110.84 14.41 L103.33 21.92 Z" fill="url(#wm-a)" stroke="url(#wm-a)"
        stroke-width="3" stroke-linejoin="round" />
  <path class="key" data-key="b" d="M197.80 -60.80 L150.20 -13.20 L143.37 -20.03 L183.46 -60.11 L159.16 -84.41 L166.67 -91.92 Z" fill="url(#wm-b)" stroke="url(#wm-b)"
        stroke-width="3" stroke-linejoin="round" />

  <path class="core" d="M135.0 -50.0 L150.0 -35.0 L135.0 -20.0 L120.0 -35.0 Z" fill="#fff" stroke="#fff" stroke-width="8"
        stroke-linejoin="round" opacity="0" />
  <g class="swirl" clip-path="url(#wm-dia)" filter="url(#wm-soft)" opacity="0">
    <ellipse data-blob="0" cx="135.0" cy="-35.0" rx="20" ry="18" fill="#5ad7ff" />
    <ellipse data-blob="1" cx="135.0" cy="-35.0" rx="20" ry="18" fill="#8a70ff" />
    <ellipse data-blob="2" cx="135.0" cy="-35.0" rx="20" ry="18" fill="#ff4f9e" />
  </g>
</svg>

<script is:inline>
  (function () {
    var D = {"a":{"fat":[[98.0,-35.0],[119.8,-56.8],[128.44,-48.16],[115.29,-35.0],[128.44,-21.84],[119.8,-13.2]],"thin":[[98.0,-35.0],[119.8,-56.8],[126.63,-49.97],[111.65,-35.0],[126.63,-20.03],[119.8,-13.2]],"to":[[72.2,-9.2],[119.8,-56.8],[126.63,-49.97],[86.54,-9.89],[110.84,14.41],[103.33,21.92]],"p":[119.8,-56.8],"t":[-110.95,-12.01]},"b":{"fat":[[172.0,-35.0],[150.2,-13.2],[141.56,-21.84],[154.71,-35.0],[141.56,-48.16],[150.2,-56.8]],"thin":[[172.0,-35.0],[150.2,-13.2],[143.37,-20.03],[158.35,-35.0],[143.37,-49.97],[150.2,-56.8]],"to":[[197.8,-60.8],[150.2,-13.2],[143.37,-20.03],[183.46,-60.11],[159.16,-84.41],[166.67,-91.92]],"p":[150.2,-13.2],"t":[107.81,11.7]}};
    var SW = [[0.0, 1.0], [2.1, 0.78], [4.2, 1.22]];
    var svg = document.currentScript.previousElementSibling;
    if (!svg || !svg.classList.contains("wm") || svg.dataset.wmDone) return;
    svg.dataset.wmDone = "1";
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var keys = {a: svg.querySelector('[data-key="a"]'), b: svg.querySelector('[data-key="b"]')};
    var core = svg.querySelector(".core"), swirl = svg.querySelector(".swirl");
    var diaclip = svg.querySelector(".diaclip"), letters = svg.querySelector(".letters");
    var blobs = [].slice.call(svg.querySelectorAll("[data-blob]"));
    if (!keys.a || !keys.b || !core) return;

    var CX = 135.0, CY = -35.0, C1 = 2.2, C3 = 3.2;
    var HOLD = 0.04, TRAVEL = 0.62, DUR = 2200;
    var T_PEAK = 0.3542, SNAP_END = 0.6, MORPH_END = 0.4402;
    var IN0 = 0.0400, IN1 = 0.2900;
    var OUT0 = 0.2900, OUT1 = 0.3809;
    var TX0 = 0.3809, TX1 = 0.4809, DIA_MAX = 3.0;
    var DIA0 = 15.00;

    function pl(p) {
      var d = "M", i;
      for (i = 0; i < p.length; i++) d += (i ? " L" : "") + p[i][0].toFixed(2) + " " + p[i][1].toFixed(2);
      return d + " Z";
    }
    function mixp(a, b, u) {
      var o = [], i;
      for (i = 0; i < a.length; i++) o.push([a[i][0]+(b[i][0]-a[i][0])*u, a[i][1]+(b[i][1]-a[i][1])*u]);
      return o;
    }
    var oC = function (u) { return 1-Math.pow(1-u, 3); };
    var sp = function (t, a, b) { return t <= a ? 0 : t >= b ? 1 : (t-a)/(b-a); };
    // one curve out and back: velocity passes through zero at the peak, so the
    // return begins the instant it stops and there is no seam
    var back = function (u) { var k = u-1; return 1 + C3*k*k*k + C1*k*k; };
    // machine-like: quart in and out, precise rather than springy
    var mech = function (u) { return u < 0.5 ? 8*u*u*u*u : 1-Math.pow(-2*u+2, 4)/2; };
    function dia(h) {                       // a square on its point
      return "M"+CX+" "+(CY-h).toFixed(1)+" L"+(CX+h).toFixed(1)+" "+CY+
             " L"+CX+" "+(CY+h).toFixed(1)+" L"+(CX-h).toFixed(1)+" "+CY+" Z";
    }

    function apply(t) {
      var fly = back(sp(t, HOLD, TRAVEL));
      var turn = mech(sp(t, T_PEAK, SNAP_END));
      var snap = mech(sp(t, T_PEAK, MORPH_END));

      ["a", "b"].forEach(function (k) {
        var d = D[k];
        var x = d.t[0]*fly;          // out and back, level
        var y = d.t[1]*turn;         // y belongs entirely to the turn
        var shape = snap > 0 ? mixp(d.thin, d.to, snap) : mixp(d.fat, d.thin, Math.min(1, fly));
        keys[k].setAttribute("d", pl(shape));
        keys[k].setAttribute("transform",
          "translate("+x.toFixed(2)+" "+y.toFixed(2)+") rotate("+
          (-45*turn).toFixed(2)+" "+d.p[0]+" "+d.p[1]+")");
        keys[k].style.strokeWidth = (12 - 9*Math.min(1, fly)).toFixed(2);
      });

      // the white breathes in place. Growth is even and the collapse runs at one
      // constant rate the whole way down, so nothing catches at the 0.1s mark.
      var open = 1 + (DIA_MAX-1)*sp(t, IN0, IN1);
      var g = open * (1 - sp(t, OUT0, OUT1));
      var h = DIA0*g;
      core.setAttribute("d", dia(h));
      core.setAttribute("opacity", (g > 0.02 ? 1 : 0) + "");
      diaclip.setAttribute("d", dia(h));
      letters.setAttribute("opacity", oC(sp(t, TX0, TX1)).toFixed(3));

      swirl.setAttribute("opacity", (0.5*Math.min(1, (g-1)/(DIA_MAX-1) + 0.35)).toFixed(3));
      blobs.forEach(function (b, i) {
        var ang = SW[i][0] + t*SW[i][1]*6.2831853;
        var orb = h*0.30;
        b.setAttribute("cx", (CX+Math.cos(ang)*orb).toFixed(1));
        b.setAttribute("cy", (CY+Math.sin(ang)*orb).toFixed(1));
        b.setAttribute("rx", (h*0.40).toFixed(1));
        b.setAttribute("ry", (h*0.40).toFixed(1));
      });
    }

    apply(0);
    var t0 = null;
    function frame(now) {
      if (t0 === null) t0 = now;
      var t = Math.min((now-t0)/DUR, 1);
      apply(t);
      if (t < 1) requestAnimationFrame(frame);
      else {
        keys.a.style.strokeWidth = ""; keys.b.style.strokeWidth = "";
        core.setAttribute("opacity", "0"); swirl.setAttribute("opacity", "0");
        letters.setAttribute("opacity", "1");
      }
    }
    requestAnimationFrame(frame);
  })();
</script>

<style>
  /* No width here: Astro's scoping attribute would out-specify a width utility
     passed in through `class`. Inline SVG already fills its box. */
  .wm { display: block; height: auto; max-width: 100%; overflow: visible; }
  .wm .g { fill: var(--color-fg, #f4f6f8); }
</style>
