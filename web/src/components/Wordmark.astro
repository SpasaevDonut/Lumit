<style>
  /* No width here: Astro's scoping attribute would out-specify a width utility
     passed in through `class`. Inline SVG already fills its box. */
  .wm { display: block; height: auto; max-width: 100%; overflow: visible; }
  .wm .g { fill: var(--color-fg, #f4f6f8); }
  .g, .key, .core { transform-box: view-box; }

  .g  { opacity: 0; animation: wm-in .38s cubic-bezier(.22,1,.36,1) forwards; }
  .gu { animation-delay: 1.23s }
  .gm { animation-delay: 1.34s }
  .gi { animation-delay: 1.46s }

  .key { stroke-width: 3; }
  .kA { transform-origin: 116.76px -35.00px; animation: wm-a 2.8s cubic-bezier(.5,0,.2,1) forwards; }
  .kB { transform-origin: 153.24px -35.00px; animation: wm-b 2.8s cubic-bezier(.5,0,.2,1) forwards; }
  .core { transform-origin: 135.0px -35.0px; animation: wm-core 2.8s ease-out forwards; }

  @keyframes wm-in { to { opacity: 1 } }

  @keyframes wm-a {
