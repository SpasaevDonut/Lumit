---
// The Lumit wordmark, assembled on load out of the app mark.
//
// The mark reads as two chevrons either side of a white core, so that is what
// these paths are — the icon's own silhouette, six corners each. An L is also six
// corners and they correspond one for one, so the letter is a straight
// interpolation of the keyframe rather than a crossfade. The t is the L turned 180
// degrees, which is free: ">" is "<" turned 180.
//
// Beats. The core breathes: it swells, and as it goes the letters open from the
// middle outward — m first, already there before the light has finished leaving.
// Inside the swell three coloured blobs drift and beat against each other, the two
// keyframe gradients mixing in the middle. The keyframes launch fast and level,
// thinning to the L's stem without their silhouette changing, carry past the
// landing, and at the top of that overshoot turn 45 degrees and hammer down into
// place.
//
// The turn pivots on the chevron corner that BECOMES the letter corner — top-left
// on the left, bottom-right on the right. That point is mathematically fixed for
// the whole snap (asserted at build time), so the shape swings around a real nail
// while its y drops in underneath it.
//
// Driven from script rather than CSS on purpose. `d` is animatable in CSS on
// paper, but iOS Safari does not do it. Without script, or under reduced motion,
// the markup already holds the finished wordmark standing still.
interface Props { class?: string }
const { class: klass } = Astro.props;
---

<svg class:list={["wm", klass]} viewBox="-14 -92 294 106" role="img" aria-label="Lumit" fill="none">
  <defs>
    <linearGradient id="wm-a" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#86e2ff" /><stop offset="1" stop-color="#2f6fe0" />
    </linearGradient>
    <linearGradient id="wm-b" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8a70ff" /><stop offset="1" stop-color="#ff4f9e" />
    </linearGradient>
    <radialGradient id="wm-core">
      <stop offset="0" stop-color="#fff" /><stop offset="0.5" stop-color="#fff" stop-opacity="0.8" />
      <stop offset="1" stop-color="#eaf4ff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="wm-blob">
      <stop offset="0" stop-color="#fff" stop-opacity="0.9" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <filter id="wm-soft" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="9" />
    </filter>
  </defs>

  <path class="g" data-g="u" d="M80.76876401901245 1.2390613555908203Q74.91525411605835 1.2390613555908203 70.92970609664917 -1.4359354972839355Q66.94415807723999 -4.110932350158691 64.93165493011475 -8.934366703033447Q62.9191517829895 -13.757801055908203 62.9191517829895 -20.186316967010498V-52.734375H75.01908540725708V-21.476149559020996Q75.01908540725708 -15.081226825714111 77.30932235717773 -11.615592241287231Q79.59955930709839 -8.149957656860352 84.88903045654297 -8.149957656860352Q88.4160041809082 -8.149957656860352 91.26132726669312 -9.978288412094116Q94.10665035247803 -11.80661916732788 95.80860733985901 -15.765619277954102Q97.51056432723999 -19.724619388580322 97.51056432723999 -26.108229160308838V-52.734375H109.61049795150757V0.0H97.99884557723999V-12.385547161102295L98.3574390411377 -10.22031307220459Q96.10509872436523 -5.035161972045898 91.64044857025146 -1.898050308227539Q87.1757984161377 1.2390613555908203 80.76876401901245 1.2390613555908203Z" />
  <path class="g" data-g="m" d="M124.1984486579895 0.0V-52.734375H135.81010103225708V-44.0371036529541Q137.95111179351807 -48.44100475311279 142.11361408233643 -51.20722055435181Q146.27611637115479 -53.97343635559082 151.9155740737915 -53.97343635559082Q157.30814933776855 -53.97343635559082 161.13959550857544 -51.200973987579346Q164.97104167938232 -48.42851161956787 166.8417453765869 -43.220698833465576Q169.6175217628479 -48.44100475311279 174.02279376983643 -51.20722055435181Q178.42806577682495 -53.97343635559082 183.78666639328003 -53.97343635559082Q191.6069746017456 -53.97343635559082 195.93353867530823 -48.38789105415344Q200.26010274887085 -42.802345752716064 200.26010274887085 -32.56485462188721V0.0H188.16016912460327V-32.417190074920654Q188.16016912460327 -35.985565185546875 187.43399381637573 -38.72033953666687Q186.7078185081482 -41.455113887786865 184.9533200263977 -43.01976561546326Q183.19882154464722 -44.58441734313965 180.04060983657837 -44.58441734313965Q176.4398217201233 -44.58441734313965 173.7874686717987 -42.364299297332764Q171.13511562347412 -40.14418125152588 169.70717906951904 -36.10921502113342Q168.27924251556396 -32.07424879074097 168.27924251556396 -26.5968918800354V0.0H156.1793088912964V-32.417190074920654Q156.1793088912964 -35.985565185546875 155.45313358306885 -38.72873783111572Q154.7269582748413 -41.47191047668457 152.98007726669312 -43.02816390991211Q151.23319625854492 -44.58441734313965 148.12381267547607 -44.58441734313965Q144.523024559021 -44.58441734313965 141.85465574264526 -42.388713359832764Q139.18628692626953 -40.19300937652588 137.7423346042633 -36.14964485168457Q136.29838228225708 -32.10628032684326 136.29838228225708 -26.580095291137695V0.0Z" />
  <path class="g" data-g="i" d="M213.9933705329895 0.0V-52.734375H226.09330415725708V0.0Z" />

  <g class="swirl" filter="url(#wm-soft)" opacity="0">
    <ellipse data-blob="0" cx="135.0" cy="-35.0" rx="20" ry="18" fill="#5ad7ff" style="mix-blend-mode:screen" />
    <ellipse data-blob="1" cx="135.0" cy="-35.0" rx="20" ry="18" fill="#8a70ff" style="mix-blend-mode:screen" />
    <ellipse data-blob="2" cx="135.0" cy="-35.0" rx="20" ry="18" fill="#ff4f9e" style="mix-blend-mode:screen" />
  </g>
  <ellipse class="core" cx="135.0" cy="-35.0" rx="34" ry="32" fill="url(#wm-core)" opacity="0" />

  <path class="key" data-key="a" d="M69.16 -16.20 L116.76 -63.80 L123.59 -56.97 L83.50 -16.89 L107.80 7.41 L100.29 14.92 Z" fill="url(#wm-a)" stroke="url(#wm-a)"
        stroke-width="3" stroke-linejoin="round" />
  <path class="key" data-key="b" d="M200.84 -53.80 L153.24 -6.20 L146.41 -13.03 L186.50 -53.11 L162.20 -77.41 L169.71 -84.92 Z" fill="url(#wm-b)" stroke="url(#wm-b)"
        stroke-width="3" stroke-linejoin="round" />
</svg>

<script is:inline>
  (function () {
    var D = {"a":{"fat":[[87.96,-35.0],[116.76,-63.8],[131.26,-49.3],[116.96,-35.0],[131.26,-20.7],[116.76,-6.2]],"thin":[[87.96,-35.0],[116.76,-63.8],[123.59,-56.97],[101.61,-35.0],[123.59,-13.03],[116.76,-6.2]],"to":[[69.16,-16.2],[116.76,-63.8],[123.59,-56.97],[83.5,-16.89],[107.8,7.41],[100.29,14.92]],"p":[116.76,-63.8],"t":[-107.91,-5.01]},"b":{"fat":[[182.04,-35.0],[153.24,-6.2],[138.74,-20.7],[153.04,-35.0],[138.74,-49.3],[153.24,-63.8]],"thin":[[182.04,-35.0],[153.24,-6.2],[146.41,-13.03],[168.39,-35.0],[146.41,-56.97],[153.24,-63.8]],"to":[[200.84,-53.8],[153.24,-6.2],[146.41,-13.03],[186.5,-53.11],[162.2,-77.41],[169.71,-84.92]],"p":[153.24,-6.2],"t":[104.77,4.7]}};
    var SW = [[0.0, 1.0], [2.1, 0.78], [4.2, 1.22]];
    var svg = document.currentScript.previousElementSibling;
    if (!svg || !svg.classList.contains("wm") || svg.dataset.wmDone) return;
    svg.dataset.wmDone = "1";
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var keys = {a: svg.querySelector('[data-key="a"]'), b: svg.querySelector('[data-key="b"]')};
    var letters = {};
    ["u", "m", "i"].forEach(function (k) { letters[k] = svg.querySelector('[data-g="' + k + '"]'); });
    var core = svg.querySelector(".core"), swirl = svg.querySelector(".swirl");
    var blobs = [].slice.call(svg.querySelectorAll("[data-blob]"));
    if (!keys.a || !keys.b || !core) return;

    var HOLD = 0.06, OUT = 0.44, SNAP = 0.7, OVER = 0.11, DUR = 2200;
    var BREATHE = 0.36, GONE = 0.6;
    var LET = {"m": [0.26, 0.46], "u": [0.34, 0.54], "i": [0.34, 0.54]};
    var CX = 135.0, CY = -35.0;

    function poly(p) {
      var d = "M", i;
      for (i = 0; i < p.length; i++) d += (i ? " L" : "") + p[i][0].toFixed(2) + " " + p[i][1].toFixed(2);
      return d + " Z";
    }
    function mix(a, b, u) {
      var o = [], i;
      for (i = 0; i < a.length; i++) o.push([a[i][0]+(b[i][0]-a[i][0])*u, a[i][1]+(b[i][1]-a[i][1])*u]);
      return o;
    }
    var oQ = function (u) { return 1 - Math.pow(1-u, 5); };
    var oC = function (u) { return 1 - Math.pow(1-u, 3); };
    var sp = function (t, a, b) { return t <= a ? 0 : t >= b ? 1 : (t-a)/(b-a); };

    function apply(t) {
      var fly = oQ(sp(t, HOLD, OUT)), snap = oQ(sp(t, OUT, SNAP));

      ["a", "b"].forEach(function (k) {
        var d = D[k];
        var reach = fly*(1+OVER) - snap*OVER;      // out is x only, dead level
        var x = d.t[0]*reach, y = d.t[1]*snap;     // y belongs entirely to the hammer
        var shape = snap > 0 ? mix(d.thin, d.to, snap) : mix(d.fat, d.thin, fly);
        keys[k].setAttribute("d", poly(shape));
        keys[k].setAttribute("transform",
          "translate(" + x.toFixed(2) + " " + y.toFixed(2) + ") rotate(" +
          (-45*snap).toFixed(2) + " " + d.p[0] + " " + d.p[1] + ")");
        keys[k].style.strokeWidth = (12 - 9*fly).toFixed(2);
      });

      // breathe in, then out
      var inhale = oC(sp(t, 0, BREATHE)), exhale = sp(t, BREATHE, GONE);
      var s = 1 + 1.15*inhale + 0.45*exhale;
      core.setAttribute("rx", (34*s).toFixed(1));
      core.setAttribute("ry", (32*s).toFixed(1));
      core.setAttribute("opacity", ((0.8 + 0.2*inhale) * (1-exhale)).toFixed(3));

      // the two keyframe gradients turning over each other inside the light
      swirl.setAttribute("opacity", (0.85*inhale*(1-exhale)).toFixed(3));
      blobs.forEach(function (b, i) {
        var ph = SW[i][0], rate = SW[i][1];
        var ang = ph + t*rate*6.2831853;
        var orb = (16 + 13*inhale) * s * 0.42;
        b.setAttribute("cx", (CX + Math.cos(ang)*orb).toFixed(1));
        b.setAttribute("cy", (CY + Math.sin(ang)*orb*0.62).toFixed(1));
        b.setAttribute("rx", (20*s*0.55).toFixed(1));
        b.setAttribute("ry", (18*s*0.55).toFixed(1));
      });

      // letters open from the middle: m first, and already lit as the light goes
      Object.keys(LET).forEach(function (k) {
        if (letters[k]) letters[k].style.opacity = oC(sp(t, LET[k][0], LET[k][1])).toFixed(3);
      });
    }

    apply(0);
    var t0 = null;
    function frame(now) {
      if (t0 === null) t0 = now;
      var t = Math.min((now-t0)/DUR, 1);
      apply(t);
      if (t < 1) requestAnimationFrame(frame);
      else {
        keys.a.style.strokeWidth = ""; keys.b.style.strokeWidth = "";
        core.setAttribute("opacity", "0"); swirl.setAttribute("opacity", "0");
      }
    }
    requestAnimationFrame(frame);
  })();
</script>

<style>
  /* No width here: Astro's scoping attribute would out-specify a width utility
     passed in through `class`. Inline SVG already fills its box. */
  .wm { display: block; height: auto; max-width: 100%; overflow: visible; }
  .wm .g { fill: var(--color-fg, #f4f6f8); }
</style>
